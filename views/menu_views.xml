<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_payment_request_paid" model="ir.actions.act_window">
        <field name="name">Pagadas</field>
        <field name="res_model">biotex.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'paid')]</field>
    </record>

    <!-- Contabilidad / administración -->
    <menuitem id="menu_account_payment_queue" name="Solicitudes de pago" parent="account.menu_finance_payables" sequence="90"
              action="action_payment_request" groups="biotex_base.group_biotex_payments,biotex_base.group_biotex_accounting"/>
    <menuitem id="menu_account_payment_paid" name="Pagos realizados" parent="account.menu_finance_payables" sequence="91"
              action="action_payment_request_paid" groups="biotex_base.group_biotex_payments,biotex_base.group_biotex_accounting"/>
    <menuitem id="menu_account_payables_consolidated" name="CxP consolidadas" parent="account.menu_finance_reports" sequence="90"
              action="action_biotex_payables" groups="biotex_base.group_biotex_payments,biotex_base.group_biotex_accounting"/>
    <menuitem id="menu_account_receivables_consolidated" name="CxC consolidadas" parent="account.menu_finance_reports" sequence="91"
              action="action_biotex_receivables" groups="biotex_base.group_biotex_accounting"/>
    <!-- Compras consulta el estado de sus pagos -->
    <menuitem id="menu_purchase_payment_queue" name="Solicitudes de pago" parent="purchase.menu_procurement_management" sequence="35"
              action="action_payment_request" groups="biotex_base.group_biotex_purchase"/>
</odoo>
