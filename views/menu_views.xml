<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_payment_request_paid" model="ir.actions.act_window">
        <field name="name">Pagadas</field>
        <field name="res_model">biotex.payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'paid')]</field>
    </record>

    <menuitem id="menu_payments_root" name="Pagos" sequence="14" web_icon="biotex_payment_request,static/description/icon.png"
              groups="biotex_base.group_biotex_payments,biotex_base.group_biotex_accounting,biotex_base.group_biotex_purchase"/>
    <menuitem id="menu_payment_request" name="Cola de pagos" parent="menu_payments_root" sequence="10" action="action_payment_request"/>
    <menuitem id="menu_payment_request_paid" name="Pagadas" parent="menu_payments_root" sequence="20" action="action_payment_request_paid"/>
    <menuitem id="menu_payments_reports" name="Consolidados" parent="menu_payments_root" sequence="30"/>
    <menuitem id="menu_biotex_payables" name="Cuentas por pagar" parent="menu_payments_reports" sequence="10" action="action_biotex_payables"/>
    <menuitem id="menu_biotex_receivables" name="Cuentas por cobrar" parent="menu_payments_reports" sequence="20" action="action_biotex_receivables"/>

    <!-- Contabilidad los ve en su app -->
    <menuitem id="menu_account_payables_consolidated" name="CxP consolidadas" parent="account.menu_finance_reports" sequence="90"
              action="action_biotex_payables" groups="biotex_base.group_biotex_accounting"/>
    <menuitem id="menu_account_receivables_consolidated" name="CxC consolidadas" parent="account.menu_finance_reports" sequence="91"
              action="action_biotex_receivables" groups="biotex_base.group_biotex_accounting"/>
    <menuitem id="menu_account_payment_queue" name="Solicitudes de pago" parent="account.menu_finance_payables" sequence="90"
              action="action_payment_request" groups="biotex_base.group_biotex_accounting"/>
</odoo>
