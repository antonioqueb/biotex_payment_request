<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CxP consolidadas por razón social y proveedor, sin entrar servidor por servidor (R19) -->
    <record id="action_biotex_payables" model="ir.actions.act_window">
        <field name="name">Cuentas por pagar consolidadas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'search_default_group_company': 1, 'search_default_group_partner': 1, 'default_move_type': 'in_invoice'}</field>
    </record>

    <record id="view_account_move_search_biotex" model="ir.ui.view">
        <field name="name">account.move.search.biotex</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[1]" position="before">
                <filter name="biotex_over_30" string="Vencidas > 30 días"
                        domain="[('invoice_date_due', '&lt;', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d')), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter name="group_company" string="Razón social" context="{'group_by': 'company_id'}"/>
                <filter name="group_partner" string="Proveedor / cliente" context="{'group_by': 'partner_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_biotex_receivables" model="ir.actions.act_window">
        <field name="name">Cuentas por cobrar consolidadas</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="context">{'search_default_group_company': 1, 'search_default_group_partner': 1, 'default_move_type': 'out_invoice'}</field>
    </record>
</odoo>
