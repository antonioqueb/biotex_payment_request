<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_form" model="ir.ui.view">
        <field name="name">biotex.payment.request.form</field>
        <field name="model">biotex.payment.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request" type="object" string="Solicitar pago" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Aprobar" class="btn-primary" invisible="state != 'requested'" groups="biotex_base.group_biotex_payments"/>
                    <button name="action_pay" type="object" string="Registrar pago" class="btn-primary" invisible="state not in ('requested', 'approved')" groups="biotex_base.group_biotex_payments"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reabrir" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,requested,approved,paid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Urgente" bg_color="text-bg-danger" invisible="priority != '1' or state in ('paid', 'cancelled')"/>
                    <widget name="web_ribbon" title="Pagada" bg_color="text-bg-success" invisible="state != 'paid'"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Compra">
                            <field name="purchase_order_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="payment_condition"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="request_id"/>
                            <field name="contract_id"/>
                        </group>
                        <group string="Pago">
                            <field name="priority" widget="priority"/>
                            <field name="amount" readonly="state in ('paid', 'cancelled')"/>
                            <field name="amount_order"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date_needed" readonly="state in ('paid', 'cancelled')"/>
                            <field name="bank_account" readonly="state in ('paid', 'cancelled')"/>
                            <field name="days_waiting" invisible="state in ('paid', 'cancelled')"/>
                        </group>
                        <group string="Comprobante" invisible="state not in ('requested', 'approved', 'paid')">
                            <field name="date_paid" readonly="state == 'paid'"/>
                            <field name="payment_reference" readonly="state == 'paid'"/>
                            <field name="proof" filename="proof_filename" readonly="state == 'paid'"/>
                            <field name="proof_filename" invisible="1"/>
                            <field name="paid_by_id" invisible="not paid_by_id"/>
                        </group>
                        <group string="Trazabilidad">
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="date_requested"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="cancel_reason" invisible="not cancel_reason"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notas para administración..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_request_list" model="ir.ui.view">
        <field name="name">biotex.payment.request.list</field>
        <field name="model">biotex.payment.request</field>
        <field name="arch" type="xml">
            <list decoration-danger="days_waiting > 3 and state in ('requested', 'approved')" decoration-muted="state == 'cancelled'" decoration-success="state == 'paid'">
                <field name="priority" widget="priority"/>
                <field name="name"/>
                <field name="date_requested"/>
                <field name="partner_id"/>
                <field name="purchase_order_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="warehouse_id"/>
                <field name="contract_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_needed"/>
                <field name="days_waiting"/>
                <field name="date_paid" optional="show"/>
                <field name="state" widget="badge" decoration-warning="state == 'requested'" decoration-info="state == 'approved'" decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_payment_request_kanban" model="ir.ui.view">
        <field name="name">biotex.payment.request.kanban</field>
        <field name="model">biotex.payment.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="priority"/>
                <field name="days_waiting"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="name"/></strong>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="fw-bold"><field name="partner_id"/></div>
                        <div class="small text-muted"><field name="purchase_order_id"/> · <field name="warehouse_id"/></div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="fs-5"><field name="currency_id" invisible="1"/><field name="amount" widget="monetary"/></span>
                            <span t-if="record.days_waiting.raw_value > 0" class="badge" t-att-class="record.days_waiting.raw_value > 3 ? 'text-bg-danger' : 'text-bg-secondary'"><t t-esc="record.days_waiting.raw_value"/> días</span>
                        </div>
                        <div class="small text-muted" t-if="record.date_needed.raw_value">Pagar antes de <field name="date_needed"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_payment_request_search" model="ir.ui.view">
        <field name="name">biotex.payment.request.search</field>
        <field name="model">biotex.payment.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="purchase_order_id"/>
                <field name="contract_id"/>
                <filter name="pending" string="Pendientes de pago" domain="[('state', 'in', ('requested', 'approved'))]"/>
                <filter name="urgent" string="Urgentes" domain="[('priority', '=', '1'), ('state', 'in', ('requested', 'approved'))]"/>
                <filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <group>
                    <filter name="group_company" string="Razón social" context="{'group_by': 'company_id'}"/>
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_warehouse" string="Delegación" context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payment_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de pago</field>
        <field name="res_model">biotex.payment.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
